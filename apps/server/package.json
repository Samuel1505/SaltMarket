{
  "name": "@saltmarket/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --exclude 'data/**' src/main.ts",
    "dev:mock": "tsx watch src/main.ts --mock",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/websocket": "^11.3.7",
    "@privy-io/node": "0.38.0",
    "@saltmarket/chain": "workspace:*",
    "@saltmarket/shared": "workspace:*",
    "@saltmarket/sim": "workspace:*",
    "fastify": "^5.12.8",
    "jose": "6.2.14",
    "zod": "^4.6.7"
  }
}
