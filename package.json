{
  "name": "saltmarket",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @saltmarket/server dev",
    "dev:mock": "pnpm --filter @saltmarket/server dev:mock",
    "dev:chain": "LEDGER=near pnpm --filter @saltmarket/server dev",
    "sim:headless": "tsx scripts/sim-headless.ts",
    "sim:storm": "tsx scripts/sim-storm.ts",
    "sim:week": "tsx scripts/sim-week.ts",
    "sim:tune": "tsx scripts/sim-tune.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p scripts/tsconfig.json",
    "lint": "tsx scripts/lint-rules.ts"
  },
  "devDependencies": {
    "@saltmarket/shared": "workspace:*",
    "@saltmarket/sim": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
